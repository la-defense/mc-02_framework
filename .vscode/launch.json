{
    // 调试入口只负责匹配 ELF 的构建、烧录或连接，不自动启动 RTT 客户端。
    // 需要观察运行态时，使用独立任务“RTT receive only (OpenOCD native)”；它只接收日志。
    // 实时变量通过 Live Watch 查看；MC02-0100 的正式观测使用身份校验后的有限快照工具。
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DAPlink (OpenOCD)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/wsl/bench-debug/Basic_Framework_MC02_bench_safe.elf",
            "svdFile": "${workspaceFolder}/STM32H723.svd",
            "servertype": "openocd",
            "configFiles": [
                "openocd_dap.cfg"
            ],
            "runToEntryPoint": "main",
            "preLaunchTask": "build task",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            // 一键方案：preLaunchTask 会先编译烧录，并等待固件完成 RTT 初始化，再以 attach 方式进入调试。
            "name": "DAPlink (flash + attach)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/wsl/bench-debug/Basic_Framework_MC02_bench_safe.elf",
            "svdFile": "${workspaceFolder}/STM32H723.svd",
            "servertype": "openocd",
            "configFiles": [
                "openocd_dap.cfg"
            ],
            "preLaunchTask": "flash and startup wait",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "Robot single (OpenOCD, WSL)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/wsl/robot-single-debug/Basic_Framework_MC02_robot.elf",
            "svdFile": "${workspaceFolder}/STM32H723.svd",
            "servertype": "openocd",
            "configFiles": ["openocd_dap.cfg"],
            "runToEntryPoint": "main",
            "preLaunchTask": "build robot single Debug (WSL)",
            "rtos": "FreeRTOS"
        },
        {
            "name": "Robot chassis (OpenOCD, WSL)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/wsl/robot-chassis-debug/Basic_Framework_MC02_chassis_robot.elf",
            "svdFile": "${workspaceFolder}/STM32H723.svd",
            "servertype": "openocd",
            "configFiles": ["openocd_dap.cfg"],
            "runToEntryPoint": "main",
            "preLaunchTask": "build robot chassis Debug (WSL)",
            "rtos": "FreeRTOS"
        },
        {
            "name": "Robot gimbal (OpenOCD, WSL)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/wsl/robot-gimbal-debug/Basic_Framework_MC02_gimbal_robot.elf",
            "svdFile": "${workspaceFolder}/STM32H723.svd",
            "servertype": "openocd",
            "configFiles": ["openocd_dap.cfg"],
            "runToEntryPoint": "main",
            "preLaunchTask": "build robot gimbal Debug (WSL)",
            "rtos": "FreeRTOS"
        },
        {
            "name": "JLink",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/wsl/bench-debug/Basic_Framework_MC02_bench_safe.elf",
            "svdFile": "${workspaceFolder}/STM32H723.svd",
            "servertype": "jlink",
            "device": "STM32H723VG",
            "interface": "swd",
            "runToEntryPoint": "main",
            "preLaunchTask": "build task",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            // 手动 attach：固件需要已经在运行（例如刚烧录完或已运行 "download dap" 任务）。
            "name": "DAPlink-attach",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/wsl/bench-debug/Basic_Framework_MC02_bench_safe.elf",
            "svdFile": "${workspaceFolder}/STM32H723.svd",
            "servertype": "openocd",
            "configFiles": [
                "openocd_dap.cfg"
            ],
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        },
        {
            "name": "JLink-attach",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/wsl/bench-debug/Basic_Framework_MC02_bench_safe.elf",
            "svdFile": "${workspaceFolder}/STM32H723.svd",
            "servertype": "jlink",
            "device": "STM32H723VG",
            "interface": "swd",
            "rtos": "FreeRTOS",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            }
        }
    ]
}
