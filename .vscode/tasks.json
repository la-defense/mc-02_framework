{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configure bench-debug (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "cmake", "--preset", "bench-debug"],
            "problemMatcher": []
        },
        {
            "label": "build task",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "cmake", "--build", "--preset", "bench-debug"],
            "dependsOn": "configure bench-debug (WSL)",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "label": "archive bench-debug firmware (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "python3", "tools/workflow/archive_firmware.py", "--preset", "bench-debug"],
            "dependsOn": "build task",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "configure robot single Debug (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "cmake", "--preset", "robot-single-debug"],
            "problemMatcher": []
        },
        {
            "label": "build robot single Debug (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "cmake", "--build", "--preset", "robot-single-debug"],
            "dependsOn": "configure robot single Debug (WSL)",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "configure robot chassis Debug (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "cmake", "--preset", "robot-chassis-debug"],
            "problemMatcher": []
        },
        {
            "label": "build robot chassis Debug (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "cmake", "--build", "--preset", "robot-chassis-debug"],
            "dependsOn": "configure robot chassis Debug (WSL)",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "configure robot gimbal Debug (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "cmake", "--preset", "robot-gimbal-debug"],
            "problemMatcher": []
        },
        {
            "label": "build robot gimbal Debug (WSL)",
            "type": "process",
            "command": "wsl.exe",
            "args": ["--cd", "${workspaceFolder}", "--exec", "cmake", "--build", "--preset", "robot-gimbal-debug"],
            "dependsOn": "configure robot gimbal Debug (WSL)",
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "download dap",
            "type": "shell",
            "command": "${config:cortex-debug.openocdPath}",
            "args": ["-f", "openocd_dap.cfg", "-c", "program build/wsl/bench-debug/Basic_Framework_MC02_bench_safe.elf verify reset exit"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "build task",
            "problemMatcher": []
        },
        {
            "label": "download jlink",
            "type": "shell",
            "command": "${config:cortex-debug.openocdPath}",
            "args": ["-f", "openocd_jlink.cfg", "-c", "program build/wsl/bench-debug/Basic_Framework_MC02_bench_safe.elf verify reset exit"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "build task",
            "problemMatcher": []
        },
        {
            "label": "wait after flash",
            "type": "process",
            "command": "powershell.exe",
            "args": ["-NoProfile", "-Command", "Start-Sleep -Seconds 3"],
            "problemMatcher": []
        },
        {
            "label": "flash and startup wait",
            "dependsOn": ["download dap", "wait after flash"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "RTT receive only (OpenOCD native)",
            "type": "process",
            "command": "py",
            "args": [
                "-3",
                "${workspaceFolder}/tools/rtt_monitor.py",
                "--openocd", "${config:cortex-debug.openocdPath}",
                "--elf", "${workspaceFolder}/build/wsl/bench-debug/Basic_Framework_MC02_bench_safe.elf",
                "--seconds", "60"
            ],
            "options": {"cwd": "${workspaceFolder}"},
            "presentation": {"reveal": "always", "panel": "dedicated"},
            "problemMatcher": []
        }
    ]
}
