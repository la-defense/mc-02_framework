# 配置只在CMake入口解析一次，生成头由业务读取，不在各文件重复选择。
include("${CMAKE_CURRENT_LIST_DIR}/mc02_vehicle_selection.cmake")
set(MC02_VEHICLE sentinel CACHE STRING "当前车型配置")
set(MC02_PLATFORM stm32h723 CACHE STRING "芯片平台")
set(MC02_BOARD mc02 CACHE STRING "板级配置")
set(MC02_RTOS freertos CACHE STRING "RTOS后端")
if(NOT MC02_VEHICLE STREQUAL "sentinel")
    message(FATAL_ERROR "Vehicle ${MC02_VEHICLE}: configuration is not implemented; no sentinel fallback")
endif()
include("${CMAKE_SOURCE_DIR}/application/config/sentinel_robot/sentinel_build.cmake")
set(MC02_CHASSIS_TYPE "${MC02_VEHICLE_DEFAULT_CHASSIS}" CACHE STRING "车型选择的底盘实现")
set(MC02_MOTOR_DRIVERS "${MC02_VEHICLE_DRIVERS}" CACHE STRING "车型使用的电机驱动")
mc02_validate_vehicle_identity("${MC02_VEHICLE}" "${MC02_PLATFORM}" "${MC02_BOARD}"
    "${MC02_RTOS}" "${MC02_CHASSIS_TYPE}" ${MC02_MOTOR_DRIVERS})
if(NOT MC02_CHASSIS_TYPE STREQUAL MC02_VEHICLE_DEFAULT_CHASSIS OR
   NOT MC02_MOTOR_DRIVERS STREQUAL MC02_VEHICLE_DRIVERS)
    message(FATAL_ERROR "Chassis and motor selection must match the current vehicle declaration")
endif()
mc02_require_production_core("${MC02_PROFILE}" "${MC02_VEHICLE_MECHANICS_CONFIRMED}"
    "${MC02_VEHICLE_GIMBAL_IMPLEMENTED}")

option(MC02_ENABLE_LCD "启用板载LCD辅助显示" ON)
option(MC02_ENABLE_ALARM "启用RGB和蜂鸣器辅助提示" ON)
set(MC02_DEP_SAFETY "")
set(MC02_DEP_IMU SAFETY)
set(MC02_DEP_COMMUNICATION SAFETY)
set(MC02_DEP_COMMAND SAFETY COMMUNICATION REMOTE VISION)
set(MC02_DEP_CHASSIS SAFETY COMMUNICATION IMU REFEREE)
set(MC02_DEP_GIMBAL SAFETY COMMUNICATION IMU)
set(MC02_DEP_SHOOTER SAFETY COMMUNICATION COMMAND)
set(MC02_DEP_REFEREE COMMUNICATION)
set(MC02_DEP_VISION COMMUNICATION)
set(MC02_DEP_REMOTE COMMUNICATION)
set(MC02_DEP_ALARM SAFETY COMMUNICATION)
set(MC02_DEP_LCD SAFETY)
set(MC02_DEP_UI REFEREE)
set(MC02_DEP_SUPERCAP COMMUNICATION)
set(MC02_DEP_LOG "")
set(MC02_DEP_HEATER IMU)

set(MC02_ENABLED_MODULES SAFETY IMU COMMUNICATION LOG)
set(MC02_REQUIRED_MODULES SAFETY IMU COMMUNICATION)
if(MC02_PROFILE STREQUAL "bench_safe")
    list(APPEND MC02_ENABLED_MODULES VISION)
    list(APPEND MC02_REQUIRED_MODULES VISION)
    if(MC02_BENCH_RC_DIAGNOSTICS)
        list(APPEND MC02_ENABLED_MODULES REMOTE)
        list(APPEND MC02_REQUIRED_MODULES REMOTE)
    endif()
    if(MC02_BENCH_REFEREE_DIAGNOSTICS)
        list(APPEND MC02_ENABLED_MODULES REFEREE)
        list(APPEND MC02_REQUIRED_MODULES REFEREE)
    endif()
else()
    if(NOT MC02_BOARD_ROLE STREQUAL "gimbal")
        list(APPEND MC02_ENABLED_MODULES CHASSIS REFEREE)
        list(APPEND MC02_REQUIRED_MODULES CHASSIS REFEREE)
    endif()
    if(NOT MC02_BOARD_ROLE STREQUAL "chassis")
        list(APPEND MC02_ENABLED_MODULES COMMAND GIMBAL SHOOTER VISION REMOTE)
        list(APPEND MC02_REQUIRED_MODULES COMMAND GIMBAL SHOOTER REMOTE)
    endif()
endif()
if(MC02_ENABLE_LCD)
    list(APPEND MC02_ENABLED_MODULES LCD)
endif()
if(MC02_ENABLE_ALARM)
    list(APPEND MC02_ENABLED_MODULES ALARM)
endif()
if(MC02_ENABLE_REFEREE_UI)
    list(APPEND MC02_ENABLED_MODULES UI)
endif()
if(MC02_ENABLE_HEATER)
    list(APPEND MC02_ENABLED_MODULES HEATER)
    list(APPEND MC02_REQUIRED_MODULES HEATER)
endif()
mc02_validate_module_graph("${MC02_ENABLED_MODULES}" "${MC02_REQUIRED_MODULES}")
mc02_modules_mask(MC02_FEATURE_MASK ${MC02_ENABLED_MODULES})
mc02_modules_mask(MC02_REQUIRED_MASK ${MC02_REQUIRED_MODULES})
set(MC02_DEPENDENCY_INITIALIZER "")
foreach(module IN LISTS MC02_MODULE_NAMES)
    if(module IN_LIST MC02_ENABLED_MODULES)
        set(MC02_FEATURE_${module} 1)
    else()
        set(MC02_FEATURE_${module} 0)
    endif()
    mc02_modules_mask(dependency_mask ${MC02_DEP_${module}})
    string(APPEND MC02_DEPENDENCY_INITIALIZER "${dependency_mask}u,")
endforeach()
set(MC02_SELECTED_DRIVER_DJI 0)
set(MC02_SELECTED_DRIVER_LK 0)
set(MC02_SELECTED_DRIVER_HT 0)
set(MC02_SELECTED_DRIVER_DM 0)
if(MC02_PROFILE STREQUAL "robot")
    foreach(driver IN LISTS MC02_MOTOR_DRIVERS)
        string(TOUPPER "${driver}" upper_driver)
        set(MC02_SELECTED_DRIVER_${upper_driver} 1)
    endforeach()
endif()
if(MC02_PROFILE STREQUAL "robot" AND
   (MC02_FEATURE_CHASSIS OR MC02_FEATURE_GIMBAL OR MC02_FEATURE_SHOOTER))
    set(MC02_FEATURE_MOTOR_CONTROL 1)
else()
    set(MC02_FEATURE_MOTOR_CONTROL 0)
endif()
if(MC02_CHASSIS_TYPE STREQUAL "omni")
    set(MC02_CHASSIS_IS_OMNI 1)
else()
    set(MC02_CHASSIS_IS_OMNI 0)
endif()
set(MC02_BUILD_ROLE "${MC02_BOARD_ROLE}")
if(MC02_PROFILE STREQUAL "bench_safe")
    set(MC02_BUILD_ROLE bench)
endif()
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated")
configure_file("${CMAKE_SOURCE_DIR}/application/config/mc02_build_config.h.in"
    "${CMAKE_BINARY_DIR}/generated/mc02_build_config.h" @ONLY)
add_compile_definitions(MC02_CONFIG_GENERATED=1)
