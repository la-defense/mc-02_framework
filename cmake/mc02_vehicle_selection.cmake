cmake_policy(SET CMP0057 NEW)
# 车型与模块声明共用的检查入口；脚本测试和正式固件读取同一份规则。
set(MC02_MODULE_NAMES SAFETY IMU COMMUNICATION COMMAND CHASSIS GIMBAL SHOOTER
    REFEREE VISION REMOTE ALARM LCD UI SUPERCAP LOG HEATER)

# 将车型诊断用途和当前板实际启用的功能合并，决定是否使用 ADC1。
function(mc02_select_adc_resource output profile vin lcd heater lcd_diag)
    if(NOT "${profile}" MATCHES "^(robot|bench_safe)$")
        message(FATAL_ERROR "ADC selection: unsupported profile ${profile}")
    endif()
    if(NOT "${vin}" MATCHES "^(TRUE|FALSE)$")
        message(FATAL_ERROR "Vehicle VIN diagnostics must be declared TRUE or FALSE")
    endif()
    if("${profile}" STREQUAL "bench_safe" OR vin OR lcd OR heater OR lcd_diag)
        set(${output} 1 PARENT_SCOPE) # 裸板保留现有采集；任何实际使用者都需要 ADC。
    else()
        set(${output} 0 PARENT_SCOPE) # 本板无使用者时不初始化或周期调用 ADC。
    endif()
endfunction()

function(mc02_validate_vehicle_identity vehicle platform board rtos chassis)
    if(NOT "${vehicle}" STREQUAL "sentinel")
        message(FATAL_ERROR "Vehicle ${vehicle}: configuration is not implemented; no sentinel fallback")
    endif()
    if(NOT "${platform}/${board}/${rtos}" STREQUAL "stm32h723/mc02/freertos")
        message(FATAL_ERROR "Unsupported platform/board/RTOS: ${platform}/${board}/${rtos}")
    endif()
    if(NOT "${chassis}" MATCHES "^(mecanum|omni)$")
        message(FATAL_ERROR "Chassis ${chassis}: implementation unavailable")
    endif()
    foreach(driver IN LISTS ARGN)
        if(driver STREQUAL "dm")
            # 旧 DM 驱动尚未接入可移植源码和任务派发，不能让车型配置误选。
            message(FATAL_ERROR "Motor driver dm: platform integration unavailable; see MC02-0051 / MC02-0073")
        elseif(NOT driver MATCHES "^(dji|lk|ht)$")
            message(FATAL_ERROR "Motor driver ${driver}: implementation unavailable")
        endif()
    endforeach()
endfunction()

function(mc02_validate_power_plan profile)
    # 固定三路电源，避免漏写其中一路后误当作已确认关闭。
    list(LENGTH ARGN rail_count)
    if(NOT rail_count EQUAL 3)
        message(FATAL_ERROR "Vehicle power plan must declare all three controlled rails")
    endif()
    foreach(rail IN LISTS ARGN)
        # OFF 表示确认不使用；两个阶段由后续板级启动流程执行。
        if(NOT rail MATCHES "^(UNCONFIRMED|OFF|BEFORE_DEVICES|AFTER_DEVICES)$")
            message(FATAL_ERROR "Vehicle power plan contains invalid rail stage: ${rail}")
        endif()
        if("${profile}" STREQUAL "robot" AND rail STREQUAL "UNCONFIRMED")
            message(FATAL_ERROR "Vehicle controlled power load or stage is unconfirmed; see MC02-0067")
        endif()
    endforeach()
endfunction()

# 生成本板实际用到的一路电源及使用它的模块；不为尚未确认的负载填写示例值。
function(mc02_prepare_power_rail out_stage out_mask profile rail stage declared enabled consumers)
    if(NOT "${stage}" MATCHES "^(UNCONFIRMED|OFF|BEFORE_DEVICES|AFTER_DEVICES)$")
        message(FATAL_ERROR "Power ${rail}: invalid stage ${stage}")
    endif()
    if("${stage}" STREQUAL "UNCONFIRMED" AND "${profile}" STREQUAL "robot")
        message(FATAL_ERROR "Power ${rail}: load or stage is unconfirmed")
    endif()
    if("${stage}" MATCHES "^(OFF|UNCONFIRMED)$" AND NOT "${consumers}" STREQUAL "")
        message(FATAL_ERROR "Power ${rail}: disabled or unconfirmed rail has consumers")
    endif()
    if("${stage}" MATCHES "^(BEFORE_DEVICES|AFTER_DEVICES)$" AND "${consumers}" STREQUAL "")
        message(FATAL_ERROR "Power ${rail}: enabled rail requires declared consumers")
    endif()
    set(active_consumers "") # 只保留本板实际启用的模块。
    foreach(module IN LISTS consumers)
        if(NOT module IN_LIST declared)
            message(FATAL_ERROR "Power ${rail}: undeclared module ${module}")
        endif()
        if(module IN_LIST enabled)
            list(APPEND active_consumers "${module}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES active_consumers) # 同一模块重复声明不改变影响范围。
    set(stage_value 0) # 0 表示保持关闭。
    set(mask 0) # 没有本板使用者时不申请输出。
    if("${profile}" STREQUAL "robot" AND active_consumers)
        mc02_modules_mask(mask ${active_consumers})
        if("${stage}" STREQUAL "BEFORE_DEVICES")
            set(stage_value 1) # 1 表示设备初始化前开启。
        elseif("${stage}" STREQUAL "AFTER_DEVICES")
            set(stage_value 2) # 2 表示设备初始化后开启。
        endif()
    endif()
    set(${out_stage} "${stage_value}" PARENT_SCOPE)
    set(${out_mask} "${mask}" PARENT_SCOPE)
endfunction()

function(mc02_require_production_core profile mechanics gimbal)
    if("${profile}" STREQUAL "robot" AND (NOT mechanics OR NOT gimbal))
        message(FATAL_ERROR "sentinel core configuration is unconfirmed or unavailable: APP-10 mechanical data / MC02-0058 three-axis gimbal; robot firmware is forbidden")
    endif()
endfunction()

function(mc02_validate_module_graph enabled required)
    foreach(module IN LISTS enabled required)
        if(NOT module IN_LIST MC02_MODULE_NAMES)
            message(FATAL_ERROR "Unknown module ${module}")
        endif()
    endforeach()
    foreach(module IN LISTS required)
        if(NOT module IN_LIST enabled)
            message(FATAL_ERROR "Required module ${module} is disabled")
        endif()
    endforeach()
    foreach(module IN LISTS enabled)
        foreach(dependency IN LISTS MC02_DEP_${module})
            if(NOT dependency IN_LIST enabled)
                message(FATAL_ERROR "Module ${module}: missing dependency ${dependency}")
            endif()
        endforeach()
    endforeach()
    set(visited "")
    foreach(pass RANGE 1 16)
        foreach(module IN LISTS enabled)
            set(ready TRUE)
            foreach(dependency IN LISTS MC02_DEP_${module})
                if(NOT dependency IN_LIST visited)
                    set(ready FALSE)
                endif()
            endforeach()
            if(ready)
                list(APPEND visited "${module}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES visited)
    endforeach()
    foreach(module IN LISTS enabled)
        if(NOT module IN_LIST visited)
            message(FATAL_ERROR "Module dependency cycle includes ${module}")
        endif()
    endforeach()
endfunction()

function(mc02_modules_mask output)
    set(mask 0)
    foreach(module IN LISTS ARGN)
        list(FIND MC02_MODULE_NAMES "${module}" index)
        if(index LESS 0)
            message(FATAL_ERROR "Unknown module ${module}")
        endif()
        math(EXPR mask "${mask} | (1 << ${index})")
    endforeach()
    set(${output} ${mask} PARENT_SCOPE)
endfunction()
