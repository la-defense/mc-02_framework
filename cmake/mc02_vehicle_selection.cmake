cmake_policy(SET CMP0057 NEW)
# 车型与模块声明共用的检查入口；脚本测试和正式固件读取同一份规则。
set(MC02_MODULE_NAMES SAFETY IMU COMMUNICATION COMMAND CHASSIS GIMBAL SHOOTER
    REFEREE VISION REMOTE ALARM LCD UI SUPERCAP LOG HEATER)

function(mc02_validate_vehicle_identity vehicle platform board rtos chassis)
    if(NOT "${vehicle}" STREQUAL "sentinel")
        message(FATAL_ERROR "Vehicle ${vehicle}: configuration is not implemented; no sentinel fallback")
    endif()
    if(NOT "${platform}/${board}/${rtos}" STREQUAL "stm32h723/mc02/freertos")
        message(FATAL_ERROR "Unsupported platform/board/RTOS: ${platform}/${board}/${rtos}")
    endif()
    if(NOT "${chassis}" MATCHES "^(mecanum|omni)$")
        message(FATAL_ERROR "Chassis ${chassis}: implementation unavailable")
    endif()
    foreach(driver IN LISTS ARGN)
        if(NOT driver MATCHES "^(dji|lk|ht|dm)$")
            message(FATAL_ERROR "Motor driver ${driver}: implementation unavailable")
        endif()
    endforeach()
endfunction()

function(mc02_require_production_core profile mechanics gimbal)
    if("${profile}" STREQUAL "robot" AND (NOT mechanics OR NOT gimbal))
        message(FATAL_ERROR "sentinel core configuration is unconfirmed or unavailable: APP-10 mechanical data / MC02-0058 three-axis gimbal; robot firmware is forbidden")
    endif()
endfunction()

function(mc02_validate_module_graph enabled required)
    foreach(module IN LISTS enabled required)
        if(NOT module IN_LIST MC02_MODULE_NAMES)
            message(FATAL_ERROR "Unknown module ${module}")
        endif()
    endforeach()
    foreach(module IN LISTS required)
        if(NOT module IN_LIST enabled)
            message(FATAL_ERROR "Required module ${module} is disabled")
        endif()
    endforeach()
    foreach(module IN LISTS enabled)
        foreach(dependency IN LISTS MC02_DEP_${module})
            if(NOT dependency IN_LIST enabled)
                message(FATAL_ERROR "Module ${module}: missing dependency ${dependency}")
            endif()
        endforeach()
    endforeach()
    set(visited "")
    foreach(pass RANGE 1 16)
        foreach(module IN LISTS enabled)
            set(ready TRUE)
            foreach(dependency IN LISTS MC02_DEP_${module})
                if(NOT dependency IN_LIST visited)
                    set(ready FALSE)
                endif()
            endforeach()
            if(ready)
                list(APPEND visited "${module}")
            endif()
        endforeach()
        list(REMOVE_DUPLICATES visited)
    endforeach()
    foreach(module IN LISTS enabled)
        if(NOT module IN_LIST visited)
            message(FATAL_ERROR "Module dependency cycle includes ${module}")
        endif()
    endforeach()
endfunction()

function(mc02_modules_mask output)
    set(mask 0)
    foreach(module IN LISTS ARGN)
        list(FIND MC02_MODULE_NAMES "${module}" index)
        if(index LESS 0)
            message(FATAL_ERROR "Unknown module ${module}")
        endif()
        math(EXPR mask "${mask} | (1 << ${index})")
    endforeach()
    set(${output} ${mask} PARENT_SCOPE)
endfunction()
